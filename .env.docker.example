# Runtime configuration template for SupportIQ Docker Compose.
# Copy to `.env.docker` (gitignored), fill strong non-empty passwords and local HF cache path,
# then run: docker compose --env-file .env.docker up -d --build
# Note: Do NOT reuse native `.local/application.json` passwords if you want independent Docker credentials.

# Host loopback port for backend + built React SPA (coexists with native 127.0.0.1:8080)
SUPPORTIQ_HOST_PORT=8081

# Browser CSRF allowed origins & session cookie setting for local HTTP loopback access
SUPPORTIQ_ALLOWED_ORIGINS=["http://127.0.0.1:8081","http://localhost:8081"]
SUPPORTIQ_SESSION_COOKIE_SECURE=false

# PostgreSQL 16 settings (internal Docker network only)
SUPPORTIQ_POSTGRES_DB=supportiq
SUPPORTIQ_POSTGRES_OWNER_PASSWORD=replace-with-strong-owner-password
SUPPORTIQ_POSTGRES_APP_PASSWORD=replace-with-strong-app-password

# Demo account passwords used ONLY on first-start seed (ignored on subsequent restarts)
SUPPORTIQ_DEMO_CUSTOMER_PASSWORD=replace-with-demo-customer-password
SUPPORTIQ_DEMO_STAFF_PASSWORD=replace-with-demo-staff-password
SUPPORTIQ_DEMO_MANAGER_PASSWORD=replace-with-demo-manager-password
SUPPORTIQ_DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password

# Existing host Hugging Face cache directory containing models--BAAI--bge-small-en-v1.5 (mounted read-only)
# Windows example: C:/Users/<you>/.cache/huggingface
# Linux/WSL example: /home/<you>/.cache/huggingface
SUPPORTIQ_HF_CACHE_DIR=/path/to/your/.cache/huggingface

# Gemini 3.5 Flash Lite drafting (runtime-injected; leave GEMINI_API_KEY empty to boot without live LLM)
SUPPORTIQ_ENABLE_LLM=true
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
SUPPORTIQ_MAX_LIVE_LLM_REQUESTS=2
SUPPORTIQ_LLM_MAX_ATTEMPTS=1
