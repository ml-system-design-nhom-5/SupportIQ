# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python environments and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-cleanup.lock
.pytest-*/
.review-system-probe-*/
.mypy_cache/
.ruff_cache/

# JavaScript dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Local datasets and generated artifacts
/data/datasets/*
!/data/datasets/.gitkeep
/artifacts/models/*
!/artifacts/models/.gitkeep
/artifacts/search-index/*
!/artifacts/search-index/.gitkeep

# Generated pipeline reports
/artifacts/preparation/
/artifacts/training/
/artifacts/evaluation/
/artifacts/monitoring/

# Local persistence and logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.zip
/logs/
/tmp/
/data/queries.active
/data/wal/
/infra/compose/volumes/

# Operating system files
.DS_Store
Thumbs.db
.playwright-mcp/
*.png

# Superpowers and worktrees
.superpowers/
.worktrees/
worktrees/

# Application runtime data and local credentials
.local/
.taste-skill/
.impeccable/
apps/frontend/test-results/
apps/frontend/playwright-report/


# Version pipeline reports and preserve model directory structure
!/artifacts/**/
!/artifacts/**/*
/artifacts/models/**/*
!/artifacts/models/**/
/artifacts/**/*.joblib
/artifacts/**/*.safetensors
/artifacts/**/*.zip
!/artifacts/**/.gitkeep

# Evaluation run outputs: regenerated by scripts/run_autoeval.ps1 and by the admin evaluation endpoint.
# Must stay after the re-include rules above.
/artifacts/evaluation/autoeval/*/
/artifacts/evaluation/autoeval/latest.txt
/artifacts/evaluation/autoeval/local-run.log
/artifacts/evaluation/eval-*/

# Out-of-fold predictions of training runs: large, regenerated by the training script.
/artifacts/training/**/oof_predictions.csv
