# Secrets: only the placeholder file is committed (SEC-10)
.env
.env.*
!.env.example

# Data: the raw Bitext download and intermediate outputs are not committed (DATA-07)
data/raw/bitext/
data/interim/
# The code that ml/ took over from main still writes its datasets here, until the first PR
# after the join moves it to data/raw/bitext/ and removes this line (ADR-0021)
data/datasets/

# Model weights and local databases: weights are release assets, never committed
# (ADR-0021, Large files and data, statement 5; ADR-0018, Artifact store)
*.safetensors
*.pt
*.sqlite3

# Evaluation exports: written only to git-ignored folders, never committed (SEC-33)
exports/

# The local run: its generated secrets, logs, and lock (docs/design/local-run.md)
/.local-run/

# Claude Code personal files
.claude/settings.local.json
CLAUDE.local.md

