# Database URLs with distinct roles and schemas
APP_DB_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/supportiq
AUDIT_WRITER_DB_URL=postgresql+asyncpg://audit_writer:audit_password@postgres:5432/supportiq
AUDIT_READER_DB_URL=postgresql+asyncpg://audit_reader:audit_password@postgres:5432/supportiq
VAULT_DB_URL=postgresql+asyncpg://vault_user:vault_password@postgres:5432/supportiq

# Redis Cache and Rate Limiting
REDIS_URL=redis://redis:6379/0

# Security Credentials
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=change-me-to-a-secure-random-key-at-least-32-chars-long
INTERNAL_SERVICE_TOKEN=change-me-to-a-secure-internal-token-for-micro-auth

# Service URLs
ML_INFERENCE_URL=http://ml-inference:8001
EGRESS_PROXY_URL=http://egress-proxy:3128
PII_RESOLVER_URL=http://pii-resolver:8002

# Environment Mode
ENVIRONMENT=production
