# Settings of frontend (README.md, Settings). Every setting has a safe default, so a fresh clone
# runs without a .env file. Values here are examples, not secrets.

# Dev server and `vite preview` only: where /v1 and /health are proxied. The default is the Prism
# mock of contracts/README.md.
SUPPORTIQ_BACKEND_URL=http://127.0.0.1:4010

# How long frontend waits for each backend response, in ms (backend contract, Timeouts).
VITE_REQUEST_TIMEOUT_MS=10000
# How many times a retryable request is sent again (ERR-12, ERR-13).
VITE_REQUEST_RETRY_MAX_COUNT=2
# The first retry delay in ms, doubled for each later attempt, with jitter (ERR-13).
VITE_REQUEST_RETRY_BASE_DELAY_MS=500
