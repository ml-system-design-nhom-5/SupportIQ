{
  "name": "supportiq-frontend",
  "private": true,
  "description": "The SupportIQ frontend: sign-in, the demo shop, the admin area, and the console shell.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-with-mock.ts",
    "build": "vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../contracts/backend.openapi.yaml --output src/api/generated/backend.ts",
    "check:api": "node scripts/check-generated-api.ts",
    "typecheck": "tsc --project tsconfig.app.json && tsc --project tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "prettier --check . && eslint . --max-warnings 0 && tsc --project tsconfig.app.json && tsc --project tsconfig.node.json && depcruise src --config .dependency-cruiser.cjs && node scripts/check-generated-api.ts",
    "test": "vitest run --project unit --coverage && vitest run --project storybook && playwright test",
    "test:unit": "vitest run --project unit --coverage",
    "test:stories": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
