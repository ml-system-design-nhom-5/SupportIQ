    "sublinear_tf": true,
    "lowercase": true
  },
  "models": [
    {
      "model_id": "logistic_regression",
      "estimator": "LogisticRegression",
      "grid": {
        "C": [20.0]
      },
      "fixed_params": {
        "solver": "lbfgs",
        "max_iter": 2000,
        "tol": 0.0001,
        "class_weight": null
      }
    }
  ]
}
