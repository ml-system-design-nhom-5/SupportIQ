{
  "schema_version": 1,
  "seed": 42,
  "n_folds": 10,
  "cv_target_macro_f1": 0.85,
  "tie_break": [
    "macro_f1_mean_desc",
    "macro_f1_std_asc",
    "config_order"
  ],
  "tfidf": {
    "ngram_range": [1, 2],
