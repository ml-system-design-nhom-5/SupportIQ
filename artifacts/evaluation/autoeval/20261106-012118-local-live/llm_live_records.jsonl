{"id": "sup-return_product-04", "kind": "order_lookup", "expect": "draft", "evidence_docs": ["b1000000-0000-0000-0000-000000000001", "POL-RET-001", "POL-RET-002"], "outcome": "draft", "latency_s": 0.9459179999994376, "usage": {"promptTokenCount": 1324, "candidatesTokenCount": 176, "totalTokenCount": 1500}, "body": "To initiate a return, please navigate to 'Account' > 'Order Management' in the Tiki app, select the order once the status is 'Delivered', and tap 'Request Return/Exchange' [S3]. You will need to provide a reason and upload 3-5 clear photos or a video of the product [S3]. Returns for products distributed by Tiki Trading are accepted within 30 days, while products from marketplace partner sellers must be requested within 7 days of successful delivery [S2]. Please ensure the returned item includes the original packaging, accessories, invoices, promotional gifts, and intact security seals, with no signs of use or laundering [S2].", "cited_docs": ["POL-RET-001", "POL-RET-002"], "analysis": {"claim_sentences": 4, "cited_sentences": 4, "uncited_sentences": [], "numbers": 4, "unsupported_numbers": [], "commitments": []}, "gold_cited": true, "must_mention_ok": null, "must_not_violations": []}
