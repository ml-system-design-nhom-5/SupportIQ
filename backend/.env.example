# Settings of backend (ARCH-35). Copy this file to backend/.env, which git ignores, and replace
# every placeholder. Each variable has the name of its setting; the initial values come from the
# Settings table of docs/design/backend-foundation.md. Never commit real values (SEC-09, SEC-10).

# Connection string of the backend replicas, as the role supportiq_app (ADR-0011). Secret.
DATABASE_URL_APP=postgresql+asyncpg://supportiq_app:replace-with-app-password@127.0.0.1:5433/supportiq
# Connection string of the owner, used only by the create-app-role, migrate, seed, and reset
# commands. The replicas never receive it. Secret.
DATABASE_URL_OWNER=postgresql+asyncpg://supportiq_owner:replace-with-owner-password@127.0.0.1:5433/supportiq

# Database timeouts in milliseconds (ERR-09). The lock timeout bounds the idempotency wait and
# the advisory lock of account changes.
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_POOL_TIMEOUT_MS=3000

# Session expiry in milliseconds (ADR-0009, statement 6): 30 minutes idle, 8 hours at most.
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_LIFETIME_MS=28800000
# How often a request may update last_seen_at, in milliseconds (backend foundation design).
SESSION_TOUCH_INTERVAL_MS=60000
# Secure attribute of the session cookie (ADR-0009, statement 4). false only in local
# development over plain HTTP (ARCH-37).
SESSION_COOKIE_SECURE=false

# Origins allowed to send state-changing requests, as a JSON list in single quotes, so that a
# dotenv parser keeps its double quotes (ADR-0009, statement 7).
ALLOWED_ORIGINS='["http://localhost:5173"]'

# Sign-in throttle per login name (ADR-0009, statement 8): the failure limit, its window in
# milliseconds, and the wait of every attempt at the limit, in milliseconds.
SIGN_IN_FAILURE_LIMIT=5
SIGN_IN_FAILURE_WINDOW_MS=900000
SIGN_IN_FAILURE_DELAY_MS=2000

# How long an idempotency record is kept, in milliseconds (ERR-15).
IDEMPOTENCY_RETENTION_MS=86400000

# Handling mode of new shop tickets: assisted or manual (contracts v1 design, Ticket lifecycle).
DEFAULT_HANDLING_MODE=assisted

# Passwords of the seeded demo accounts, one per role, from 1 to 128 characters (ADR-0009,
# statement 1). Only the seed and reset commands read them. Secret.
SEED_PASSWORD_CUSTOMER=replace-with-customer-password
SEED_PASSWORD_STAFF=replace-with-staff-password
SEED_PASSWORD_MANAGER=replace-with-manager-password
SEED_PASSWORD_ADMIN=replace-with-admin-password

# Where finished trace spans go: none keeps them in the process, otlp exports them to the
# endpoint (ADR-0007). The export timeout is in milliseconds (ERR-09).
TRACE_EXPORTER=none
# Traces endpoint of the OpenTelemetry collector. Required, and only read, when TRACE_EXPORTER is
# otlp; uncomment it then.
# OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTLP_EXPORT_TIMEOUT_MS=10000
