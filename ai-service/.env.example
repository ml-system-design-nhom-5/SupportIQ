# Settings of ai-service, one environment variable per setting (ARCH-33). Copy this file to
# .env and replace every placeholder. .env is ignored by git, and its values never leave your
# machine. The deployed service reads the same names from Modal Secrets (ADR-0018, Secrets).

# The token that backend sends as `Authorization: Bearer <token>`: the same value as the
# backend setting AI_SERVICE_TOKEN. Secret. Choose a long random value of your own.
SERVICE_TOKEN=replace-with-the-service-token

# The release manifest that ai-service serves; its assets are in the same folder. Required:
# ai-service checks the manifest and every file it names at startup, and stops when one is
# missing or does not match. This placeholder names no file, so ai-service stops until it
# names a real release.
RELEASE_MANIFEST_PATH=/path/to/release/release-manifest.json

# The Gemini API key, used for nothing else. Secret. On Modal it is a Modal Secret.
GEMINI_API_KEY=replace-with-a-gemini-api-key

# The Gemini model that drafts; the model of main.
GEMINI_MODEL=gemini-3.5-flash-lite

# The prices of the tokens of GEMINI_MODEL, in millionths of a US dollar for one million tokens,
# from the price list of the provider. Required and without a default: these empty values stop
# ai-service until the real prices are filled in.
LLM_INPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=

# The budget of the whole LLM step, retries and waits included, at most 10000 (NFR-07).
LLM_BUDGET_MS=10000

# The timeout of one LLM attempt, within the budget; the value of main.
LLM_ATTEMPT_TIMEOUT_MS=5000

# The attempts of one LLM step, the first one included, from 1 to 3; the value of main.
LLM_MAX_ATTEMPTS=2

# The backoff before the second attempt, doubled after, and its maximum; the values of main.
LLM_BACKOFF_BASE_MS=250
LLM_BACKOFF_MAX_MS=2000

# The maximum number of output tokens of a draft; the value of main.
LLM_MAX_OUTPUT_TOKENS=1024

# The temperature of a draft, which only Gemini 2.5 models take; the value of main.
LLM_TEMPERATURE=0.1
