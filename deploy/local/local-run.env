# The non-secret values that both ways of the local run share (docs/design/local-run.md, Ports
# and settings). local-run.sh reads this file, and Compose reads it through --env-file. No value
# here is a secret: the generated secrets live in .local-run/secrets.env, which git ignores.

# The host ports, each published on 127.0.0.1 only.
LOCAL_FRONTEND_PORT=5173
LOCAL_BACKEND_PORT=8000
LOCAL_AI_SERVICE_PORT=8001
LOCAL_GRAFANA_PORT=3000
# The default host port of PostgreSQL. LOCAL_DB_PORT in your environment replaces it;
# local-run.sh checks the value and records it in .local-run/db-port.
LOCAL_DB_PORT=5434

# Both loopback origins of the page. The proxy of the dev server keeps the Origin of the
# browser, so a page opened at either one signs in (ADR-0009, statement 7).
LOCAL_ALLOWED_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# The build version that the admin area shows, as backend/.env.example sets it.
LOCAL_BACKEND_BUILD_VERSION=local
