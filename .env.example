# SupportIQ Local Environment Configuration
# Copy this file to .env: cp .env.example .env

# LLM Provider settings for ai-service (required for --with-ai mode)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_INPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=150
LLM_OUTPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=600

# Docker Compose defaults (enables running `docker compose ps` and `docker compose logs` directly from repo root)
COMPOSE_FILE=deploy/local/compose.yaml
COMPOSE_PROJECT_NAME=supportiq-local
COMPOSE_ENV_FILES=deploy/local/local-run.env,.local-run/secrets.env
