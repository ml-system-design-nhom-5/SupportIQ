# Local server configuration. Copy to .env and keep credentials out of Git/frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=7

# Native Windows application: generated database URLs and account passwords live in .local/.
# Optional override when PostgreSQL binaries are not discovered automatically.
SUPPORTIQ_PG_BIN=
# External drafting uses the configured Gemini key. Start with -DisableLLM to disable it.
SUPPORTIQ_ENABLE_LLM=true
